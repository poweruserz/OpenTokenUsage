{
  "schemaVersion": 1,
  "id": "claude",
  "name": "Claude",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#DE7356",
  "statusPageUrl": "https://status.claude.com",
  "links": [
    { "label": "Status", "url": "https://status.anthropic.com/" },
    { "label": "Console", "url": "https://console.anthropic.com/" },
    { "label": "Usage dashboard", "url": "https://claude.ai/settings/usage" }
  ],
  "wsl": { "login": ["~/.claude/.credentials.json"] },
  "lines": [
    { "type": "badge", "label": "Status", "scope": "overview" },
    { "type": "progress", "label": "Session", "scope": "overview", "primaryOrder": 1 },
    { "type": "progress", "label": "Weekly", "scope": "overview", "period": "weekly", "primaryOrder": 2 },
    { "type": "progress", "label": "Fable", "scope": "overview" },
    { "type": "progress", "label": "Sonnet", "scope": "detail" },
    { "type": "progress", "label": "Claude Design", "scope": "detail" },
    { "type": "progress", "label": "Extra usage spent", "scope": "overview", "primaryOrder": 3 },
    { "type": "text", "label": "Rate Limit Resets", "scope": "overview" },
    { "type": "text", "label": "Today", "scope": "detail" },
    { "type": "text", "label": "Yesterday", "scope": "detail" },
    { "type": "text", "label": "Last 30 Days", "scope": "detail" },
    { "type": "barChart", "label": "Usage Trend", "scope": "detail" }
  ]
}
